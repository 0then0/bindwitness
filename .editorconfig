root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.go]
indent_style = tab
indent_size = 8
tab_width = 8

[*.{json,yml,yaml,sh}]
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Captured diagnostics and reports are evidence, not editable source.
[testdata/{traces,reports}/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
