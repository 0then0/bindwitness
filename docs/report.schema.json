{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BindWitness v1 report",
  "oneOf": [
    {
      "$ref": "#/$defs/observation"
    },
    {
      "$ref": "#/$defs/result"
    }
  ],
  "$defs": {
    "binding": {
      "type": "object",
      "properties": {
        "reference": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "trace_version": {
          "type": "string"
        },
        "pid": {
          "type": "integer"
        },
        "reference_namespace": {
          "type": "integer"
        },
        "provider_namespace": {
          "type": "integer"
        },
        "trace_line": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "reference",
        "provider",
        "symbol",
        "trace_version",
        "pid",
        "reference_namespace",
        "provider_namespace",
        "trace_line"
      ],
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "selector_index": {
          "type": "integer",
          "minimum": 0
        },
        "witness": {
          "$ref": "#/$defs/binding"
        },
        "other_witness": {
          "$ref": "#/$defs/binding"
        },
        "expected_providers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "message"
      ],
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "properties": {
        "observed_path": {
          "type": "string"
        },
        "resolved_path": {
          "type": "string"
        },
        "logical_id": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "elf_class": {
          "type": "string"
        },
        "machine": {
          "type": "string"
        },
        "soname": {
          "type": "string"
        },
        "build_id": {
          "type": "string"
        },
        "problem": {
          "type": "string"
        },
        "stability": {
          "enum": [
            "pre_post_unchanged",
            "post_only",
            "changed",
            "ambiguous"
          ]
        }
      },
      "required": [
        "observed_path",
        "stability"
      ],
      "additionalProperties": false
    },
    "workload": {
      "type": "object",
      "properties": {
        "started": {
          "type": "boolean"
        },
        "completed": {
          "type": "boolean"
        },
        "exit_code": {
          "type": "integer"
        },
        "deadline_exceeded": {
          "type": "boolean"
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "stdout_truncated": {
          "type": "boolean"
        },
        "stderr_truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "started",
        "completed",
        "deadline_exceeded",
        "stdout",
        "stderr",
        "stdout_truncated",
        "stderr_truncated"
      ],
      "additionalProperties": false
    },
    "capture": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "trace_truncated": {
          "type": "boolean"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      },
      "required": [
        "complete",
        "trace_truncated",
        "issues"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "tool_version": {
          "type": "string"
        },
        "backend": {
          "type": "string"
        },
        "os": {
          "type": "string"
        },
        "architecture": {
          "type": "string"
        },
        "os_release": {
          "type": "string"
        },
        "loader_path": {
          "type": "string"
        },
        "loader_sha256": {
          "type": "string"
        },
        "glibc_version": {
          "type": "string"
        },
        "started_at": {
          "type": "string"
        },
        "finished_at": {
          "type": "string"
        },
        "working_directory": {
          "type": "string"
        },
        "diagnostics_policy": {
          "type": "string"
        },
        "previous_ld_debug": {
          "type": "string"
        },
        "previous_ld_debug_output": {
          "type": "string"
        },
        "pid": {
          "type": "integer"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environment_overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "linker_environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "trace_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "tool_version",
        "backend",
        "os",
        "architecture",
        "os_release",
        "loader_path",
        "loader_sha256",
        "glibc_version",
        "started_at",
        "finished_at",
        "working_directory",
        "diagnostics_policy",
        "pid",
        "command",
        "environment_overrides",
        "linker_environment",
        "trace_sha256"
      ],
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "observation"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "workload": {
          "$ref": "#/$defs/workload"
        },
        "capture": {
          "$ref": "#/$defs/capture"
        },
        "trace": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "objects": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/identity"
          }
        }
      },
      "required": [
        "schema_version",
        "kind",
        "provenance",
        "workload",
        "capture",
        "trace",
        "bindings",
        "objects"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "selector_index": {
          "type": "integer",
          "minimum": 0
        },
        "required": {
          "type": "boolean"
        },
        "observed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "selector_index",
        "required",
        "observed"
      ],
      "additionalProperties": false
    },
    "artifact_change": {
      "type": "object",
      "properties": {
        "logical_id": {
          "type": "string"
        },
        "left_sha256": {
          "type": "string"
        },
        "right_sha256": {
          "type": "string"
        }
      },
      "required": [
        "logical_id",
        "left_sha256",
        "right_sha256"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "enum": [
            "check",
            "compare",
            "error"
          ]
        },
        "outcome": {
          "enum": [
            "PASS",
            "FAIL",
            "UNRESOLVED",
            "INFRASTRUCTURE_ERROR"
          ]
        },
        "binding_verdict": {
          "enum": [
            "PASS",
            "FAIL",
            "UNRESOLVED",
            "INFRASTRUCTURE_ERROR"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "coverage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coverage"
          }
        },
        "observation": {
          "$ref": "#/$defs/observation"
        },
        "left": {
          "$ref": "#/$defs/observation"
        },
        "right": {
          "$ref": "#/$defs/observation"
        },
        "artifact_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact_change"
          }
        }
      },
      "required": [
        "schema_version",
        "kind",
        "outcome",
        "binding_verdict",
        "findings",
        "coverage"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "check"
              }
            }
          },
          "then": {
            "required": [
              "observation"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "compare"
              }
            }
          },
          "then": {
            "required": [
              "left",
              "right"
            ]
          }
        }
      ]
    }
  }
}
