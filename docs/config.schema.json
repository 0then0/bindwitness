{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BindWitness v1 contract",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "working_directory": {
      "type": "string"
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "deadline": {
      "type": "string"
    },
    "limits": {
      "type": "object",
      "properties": {
        "stdout_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        },
        "stderr_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        },
        "trace_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        }
      },
      "required": [
        "stdout_bytes",
        "stderr_bytes",
        "trace_bytes"
      ],
      "additionalProperties": false
    },
    "roots": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "objects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "root": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "root",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "selectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "trace_version": {
            "type": "string"
          },
          "providers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "required": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "reference",
          "symbol",
          "providers"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "command",
    "deadline",
    "limits",
    "roots",
    "objects",
    "selectors"
  ],
  "additionalProperties": false
}
