{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BindWitness v1 comparison mapping",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "left_roots": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "right_roots": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "objects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "root": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "root",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "selectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "trace_version": {
            "type": "string"
          },
          "providers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "required": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "reference",
          "symbol",
          "providers"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "left_roots",
    "right_roots",
    "objects",
    "selectors"
  ],
  "additionalProperties": false
}
